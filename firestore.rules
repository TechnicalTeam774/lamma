rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      match /tokens/{tok} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /inbox/{uid}/items/{item} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
    }

    match /config/{doc} {
      allow read: if request.auth != null;
    }

    match /friends/{uid}/list/{other} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid == other);
    }

    match /requests/{uid}/incoming/{from} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == from && from != uid;
      allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == from);
    }

    match /invites/{uid}/incoming/{from} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == from && from != uid;
      allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == from);
    }

    match /rooms/{roomId} {
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow read, update: if request.auth != null && (resource.data.host == request.auth.uid || request.auth.uid in resource.data.guests);
      match /acts/{actId} {
        allow read, create: if request.auth != null && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.host == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.guests);
      }
    }

    match /chats/{pairId}/messages/{msg} {
      allow read, create: if request.auth != null && pairId.matches('.*' + request.auth.uid + '.*');
    }
  }
}
